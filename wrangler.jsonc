{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nai",
  "main": "src/index.ts",
  "compatibility_date": "2025-04-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "vars": {
    "NAI_BASE_URL": "https://text.novelai.net"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    }
  },
  "routes": [
    {
      "pattern": "nai.hoshinoaya.com",
      "custom_domain": true
    }
  ]
}
